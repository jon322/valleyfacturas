# Copia este archivo a ".env" y rellena los valores reales.
# El archivo ".env" NUNCA debe compartirse ni subirse a ningun repositorio.

# --- Banahost (correo IMAP) ---
BANAHOST_IMAP_HOST=mail.valleytechprojects.com
BANAHOST_IMAP_PORT=993
BANAHOST_EMAIL=jon@valleytechprojects.com
BANAHOST_PASSWORD=

# Carpeta IMAP donde llegan las facturas (normalmente INBOX)
BANAHOST_SOURCE_FOLDER=INBOX
# Carpeta a la que se mueven los correos ya subidos a Holded (se crea sola si no existe)
BANAHOST_PROCESSED_FOLDER=Facturas Subidas
# Carpeta a la que se mueven los correos que han dado error al subir (revision manual)
BANAHOST_ERROR_FOLDER=Facturas Error

# Remitentes permitidos, separados por comas (dejar vacio para no filtrar por remitente)
# Ejemplo: proveedor1@ejemplo.com,facturas@otroproveedor.com
ALLOWED_SENDERS=

# --- Holded ---
HOLDED_API_KEY=
# Cuenta contable de gastos y tipo de IVA por defecto para las lineas de factura.
# Se rellenan una vez con un valor real de tu plan de cuentas (revisa/ajusta el borrador en Holded despues de subirlo).
HOLDED_DEFAULT_ACCOUNT_ID=
HOLDED_DEFAULT_TAX=p_iva_21

# --- Discord (opcional: canal donde se suben fotos de facturas) ---
DISCORD_BOT_TOKEN=
DISCORD_INVOICE_CHANNEL_ID=

# --- Yoigo (MiYoigo, revision mensual) ---
YOIGO_EMAIL=
YOIGO_PASSWORD=
